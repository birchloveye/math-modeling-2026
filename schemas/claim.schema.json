{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "结论证据账本",
  "type": "array",
  "items": {"$ref": "#/$defs/claim"},
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim", "question", "source_experiment", "source_metric", "table", "figure", "code", "status"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^Q[1-9][0-9]*-C[0-9]{2,}$"},
        "claim": {"type": "string", "minLength": 1},
        "question": {"type": "string", "pattern": "^Q[1-9][0-9]*$"},
        "source_experiment": {"type": "string", "minLength": 1},
        "source_metric": {"type": "string", "minLength": 1},
        "table": {"type": ["string", "null"]},
        "figure": {"type": ["string", "null"]},
        "code": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "supported", "verified", "rejected"]}
      }
    }
  }
}
